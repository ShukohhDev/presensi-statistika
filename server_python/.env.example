# ==============================================================
# Konfigurasi Lingkungan Presensi MK Statistika
# ==============================================================

# 1. Pilihan Database MySQL:
# Ganti 'root' dan 'password' sesuai pengaturan MySQL / XAMPP / Laragon Anda:
DATABASE_URL=mysql+pymysql://root:@localhost:3306/presensi_statistika

# Catatan: Jika DATABASE_URL di atas dikosongkan atau diberi tanda pagar (#),
# sistem otomatis menggunakan SQLite lokal (presensi_lokal.db) agar aplikasi tetap bisa berjalan.

# 2. Keamanan Token JWT:
JWT_SECRET=presensi-statistika-ti25c-super-secret-key-2026

# 3. Port Server Python:
PORT=5000
