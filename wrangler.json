{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "presensi-statistika-ti25c",
  "compatibility_date": "2024-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  }
}

